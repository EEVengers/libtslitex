{
    "$id": "https://example.com/schemas/fcal",
    "title": "Factory Calibration",
    "type": "object",
    "properties": {
        "version": {
            "type": "integer",
            "minimum": 1
        },
        "serial": {
            "type": "string",
            "maxLength": 256
        },
        "timestamp": {
            "type": "string",
            "description": "UTC date/time in ISO 8601 format"
        },
        "frontend": {
            "type": "array",
            "maxItems": 4,
            "properties": {
                "channel": {
                    "type": "integer"
                },
                "attenuatorScale": {
                    "type": "number"
                },
                "path": {
                    "type": "array",
                    "items": {
                        "$ref": "/schemas/channelPathCalibration"
                    }
                }
            }
        },
        "adc":{
            "type": "object",
            "properties": {
                "loadScale": {
                    "type": "array",
                    "properties": {
                        "channel": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        },
                        "rateScale": {
                            "type" : "array",
                            "items": {
                                "$ref": "/schemas/adcRateScales"
                            }
                        }
                    }
                },
                "branchGain": {
                    "type": "array",
                    "properties": {
                        "channel": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        },
                        "rateGain": {
                            "type" : "array",
                            "items": {
                                "$ref": "/schemas/adcRateGain"
                            }
                        }
                    }
                }
            }
        }
    },
    "required": [
        "version",
        "serial",
        "frontend",
        "adc"
    ],
    "$defs": {
        "channelPathCalibration": {
            "$id": "https://example.com/schemas/channelPathCalibration",
            "title": "Channel Path Calibration",
            "type": "object",
            "properties": {
                "pgaPreampGain": {
                    "enum": ["high", "low"]
                },
                "pgaLadder": {
                    "type": "integer"
                },
                "trimDPot": {
                    "type": "integer"
                },
                "trimDacScale": {
                    "type": "number"
                },
                "trimDacZeroM": {
                    "type": "number"
                },
                "trimDacZeroC": {
                    "type": "number"
                },
                "bufferInputVpp": {
                    "type": "number"
                }
            },
            "required": [
                "pgaPreampGain",
                "pgaLadder",
                "trimDPot",
                "trimDacScale",
                "trimDacZeroM",
                "trimDacZeroC",
                "bufferInputVpp"
            ]
        },
        "adcRateScale": {
            "$id": "https://example.com/schemas/adcRateScale",
            "title": "PGA Load Scale",
            "type": "object",
            "properties": {
                "rate": {
                    "type": "integer"
                },
                "scale": {
                    "type": "array",
                    "Items": {
                        "type": "number"
                    }
                }
            },
            "required": [
                "rate",
                "scale"
            ]  
        },
        "adcRateGain": {
            "$id": "https://example.com/schemas/adcRateGain",
            "title": "ADC Rate Gain",
            "type": "object",
            "properties": {
                "rate": {
                    "type": "integer"
                },
                "gain": {
                    "type": "array",
                    "minItems": 8,
                    "maxItems": 8,
                    "items": {
                        "type": "integer"
                    }
                }
            },
            "required": [
                "rate",
                "gain"
            ]  
        }
    }
}